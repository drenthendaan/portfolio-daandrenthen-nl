# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.
#
# Gebruik lokaal een APARTE Upstash-database, niet die van productie.
# De sleutels pokemon:items en roadtrip:* hebben geen omgevingsprefix, dus met
# je productiedatabase schrijf je tijdens het testen in je echte verzameling.

# --- Database (Upstash Redis) ---------------------------------------------
# Upstash toont deze twee onder "REST API" bij je database.
# In productie heten ze bij Vercel KV_REST_API_URL en KV_REST_API_TOKEN; de code
# accepteert beide namen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bewerken toestaan ----------------------------------------------------
# Verzin zelf een waarde. Wie dit token heeft mag die sectie bewerken; lezen mag
# iedereen met de link. Twee losse tokens, zodat /roadtrip delen niet ook
# toegang tot /pokemon geeft.
PIKACHU_TOKEN=
ROADTRIP_TOKEN=

# --- Kaart en routering (/roadtrip) ---------------------------------------
# MapTiler levert de kaarttegels. Deze sleutel staat in de browser, dus beperk
# hem in het MapTiler-dashboard op domein.
NEXT_PUBLIC_MAPTILER_KEY=

# OpenRouteService geeft afstand en rijtijd per etappe. Blijft serverside: hij
# wordt alleen gebruikt in /api/roadtrip/etappe.
ORS_API_KEY=
